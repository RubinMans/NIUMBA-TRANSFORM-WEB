# NIUMBA TRANSFORM — Variables d'environnement
#
# Copiez ce fichier vers `.env` et renseignez les valeurs locales.
# `.env` ne doit jamais être versionné (déjà exclu par .gitignore).

# Base de données locale (développement) — SQLite
DATABASE_URL="file:./dev.db"

# Production (Vercel) — PostgreSQL : définir DATABASE_URL dans l'environnement
# de production. Exemple pour le futur :
# POSTGRES_URL="postgresql://user:password@host:5432/niumba_transform?schema=public"

# Niveau d'environnement
APP_ENV="development"

# URL publique du site (SEO, sitemap, robots, Open Graph).
# Vercel positionne automatiquement VERCEL_URL en prévisualisation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Premier administrateur (mission 02) ────────────────────────────────
# Utilisé par `npm run db:seed` et `npm run db:create-admin` pour créer le
# premier compte Super administrateur. Ces valeurs restent côté SERVEUR
# (jamais exposées dans le code client ni sur le site public).
# En développement local, ADMIN_EMAIL et ADMIN_PASSWORD sont définis dans
# `.env` (fichier non versionné). En production, utilisez les variables
# d'environnement de la plateforme (Vercel).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""