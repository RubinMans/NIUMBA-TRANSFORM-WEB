// NIUMBA TRANSFORM — Prisma
//
// Base de données de développement : SQLite (local).
// Production (Vercel) : PostgreSQL — la migration du provider se fera en
// changeant `datasource.provider` (les modèles restent identiques ; aucun
// type spécifique SQLite n'est utilisé).
//
// Compatibilité : SQLite ne supporte ni les enums ni les colonnes JSON.
// Les statuts, rôles et collections structurées sont donc stockés en TEXT
// (valeurs françaises canoniques définies dans `src/lib/constants.ts`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────── Authentification ──────────────────

model Role {
  key         String  @id
  label       String
  description String?
  // Liste des permissions au format JSON (ex. ["products.write", "settings.read"])
  permissions String  @default("[]")
  users       User[]

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  roleKey      String
  role         Role      @relation(fields: [roleKey], references: [key])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("sessions")
}

// ────────────────── Catalogue ──────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  label       String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  brand            String         @default("BUKHETE")
  reference        String?
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Statut : "Publié" | "Brouillon" | "À venir"
  status           String         @default("Brouillon")
  active           Boolean        @default(true)
  shortDescription String?
  description      String?
  composition      String?
  certifications   String?
  packaging        String?
  instructions     String?
  precautions      String?
  additionalInfo   String?
  videoUrl         String?
  // Chemin public de l'image principale (ex. /media/produits/savon-en-barre.jpg)
  image            String?
  featured         Boolean        @default(false)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ProductImage[]
  orderItems       OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Media {
  id        String   @id @default(cuid())
  title     String
  url       String
  // "IMAGE" | "VIDEO" | "DOCUMENT"
  type      String   @default("IMAGE")
  alt       String?
  createdAt DateTime @default(now())

  @@map("media")
}

// ────────────────── Commerce ──────────────────

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  clientName String
  phone      String?
  email      String?
  address    String?
  city       String?
  notes      String?
  // "Nouvelle" | "En traitement" | "En livraison" | "Terminée" | "Annulée"
  status     String      @default("Nouvelle")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)

  @@map("order_items")
}

model DistributorRequest {
  id          String   @id @default(cuid())
  companyName String
  contactName String?
  phone       String?
  email       String?
  zone        String?
  message     String?
  // "Nouvelle" | "En étude" | "Acceptée" | "Refusée"
  status      String   @default("Nouvelle")
  createdAt   DateTime @default(now())

  @@map("distributor_requests")
}

// ────────────────── Contenus ──────────────────

model Video {
  id          String   @id @default(cuid())
  title       String
  url         String
  duration    String?
  description String?
  // "Publié" | "Brouillon"
  status      String   @default("Brouillon")
  createdAt   DateTime @default(now())

  @@map("videos")
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  category    String?
  excerpt     String?
  content     String?
  image       String?
  // "Publié" | "Brouillon"
  status      String    @default("Brouillon")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("articles")
}

// ────────────────── Site & identité ──────────────────

/// Paramètres du site + informations de l'entreprise (ligne unique id=1).
model SiteSettings {
  id                 Int      @id @default(1)
  companyName        String   @default("NIUMBA TRANSFORM")
  legalName          String   @default("NIUMA TRANSFORM")
  brandName          String   @default("BUKHETE")
  tagline            String?  @default("La propreté qui nous ressemble")
  companyDescription String?
  rccm               String?
  idNat              String?
  nif                String?
  foundedAt          String?
  address            String?
  industrialSite     String?
  phone              String?
  whatsapp           String?
  whatsappLink       String?
  email              String?
  // Réseaux sociaux au format JSON (ex. {"facebook": "...", "instagram": "..."})
  social             String   @default("{}")
  horaires           String?
  designerCredit     String   @default("Site conçu par One Concept")
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

/// Identité visuelle (ligne unique id=1) — chemins publics des assets officiels.
model VisualIdentity {
  id             Int      @id @default(1)
  logoPath       String?
  logoDarkPath   String?
  logoSquarePath String?
  faviconPath    String?
  updatedAt      DateTime @updatedAt

  @@map("visual_identity")
}