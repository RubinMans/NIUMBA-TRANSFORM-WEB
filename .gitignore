# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# build alternatif
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets & sessions
/cookies.txt

# logs
*.log

# database (SQLite de développement)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# archives Stitch (référence visuelle déjà extraite dans STITCH_EXPORT/)
/stitch_*.zip

# photos produit provisoires (non référencées, en attente des ASSETS OFFICIELS)
/public/media/produits/*.jpg

# uploads locaux via Admin (stockage dev — mission 02.9)
/public/media/uploads/*
!/public/media/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fichiers temporaires système
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
